# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Binance Market Data APIs (Defaults to Binance public endpoints)
BINANCE_API_BASE_URL="https://api.binance.com"
BINANCE_WS_URL="wss://stream.binance.com:9443/ws"

# Firebase Client & Admin Configuration (Optional persistent cloud sync)
FIREBASE_CONFIG=""
FIREBASE_ADMIN_CONFIG=""

# Payment Provider Gateway Secrets (Modular webhooks)
PAYMENT_PROVIDER_KEYS=""

# Broker Admin Portal 3-Stage Security Verification (Keep strictly server-side)
ADMIN_ACCESS_CODE=@53595
ADMIN_PASSWORD=Jahid@5359
ADMIN_BORN_DAY=Sunday

